{
  "name": "quota-wallpaper",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Customizable Wallpaper Engine quota and balance monitor",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.js",
    "start": "node collector/main.js --serve",
    "collect": "node collector/main.js --once",
    "preview": "node scripts/preview.js",
    "package": "node scripts/package.js",
    "test:browser": "node tests/browser.js && node tests/bridge-browser.js && node tests/properties-browser.js && node tests/choices-browser.js"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "playwright": "1.64.0"
  }
}
